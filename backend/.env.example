# Copy this file to .env and fill in real values. Never commit .env.

# From Meta App Dashboard - WhatsApp - API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Use the version shown in the curl example on your API Setup page
GRAPH_API_VERSION=v23.0

# Any random string you choose. Paste the same value in Meta webhook settings
WEBHOOK_VERIFY_TOKEN=

# Meta App Dashboard - App settings - Basic - App secret. Verifies webhook signatures
META_APP_SECRET=

# Local: SQLite file. Production: a Postgres URL from Neon
DATABASE_URL=sqlite:///whatsapp.db

# Frontend origin allowed by CORS - Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# Optional: override Meta API base URL - only used by tests
META_API_BASE=https://graph.facebook.com